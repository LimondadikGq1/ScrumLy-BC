<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <changeSet id="2025-11-01-create-table-roles" author="LimonadikGq1">
        <createTable tableName="roles">
            <column name="id" type="bigserial" autoIncrement="true">
                <constraints primaryKey="true" unique="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(64)">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>

        <sql>
            alter table roles add constraint check_not_empty_name check(name != '');
        </sql>

        <rollback>
            <dropTable tableName="roles"/>
        </rollback>
    </changeSet>


    <changeSet id="2025-11-01-create-table-permissions" author="LimonadikGq1">
        <createTable tableName="permissions">
            <column name="id" type="bigserial" autoIncrement="true">
                <constraints primaryKey="true" unique="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(64)">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>

        <sql>
            alter table permissions add constraint check_not_empty_name check(name != '');
        </sql>

        <rollback>
            <dropTable tableName="permissions"/>
        </rollback>
    </changeSet>


    <changeSet id="2025-11-01-create-table-roles-permissions" author="LimonadikGq1">
        <createTable tableName="roles_permissions">
            <column name="role_id" type="bigint"/>
            <column name="permission_id" type="bigint"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="roles_permissions" baseColumnNames="role_id"
                                 constraintName="FK_roles_permissions_roles" referencedTableName="roles"
                                 referencedColumnNames="id" onDelete="RESTRICT"/>
        <addForeignKeyConstraint baseTableName="roles_permissions" baseColumnNames="permission_id"
                                 constraintName="FK_roles_permissions_permissions" referencedTableName="permissions"
                                 referencedColumnNames="id" onDelete="RESTRICT"/>

        <rollback>
            <dropTable tableName="roles_permissions"/>
        </rollback>
    </changeSet>


    <changeSet id="2025-11-01-create-table-user" author="LimonadikGq1">
        <createTable tableName="users">
            <column name="id" type="bigserial" autoIncrement="true">
                <constraints primaryKey="true" unique="true" nullable="false"/>
            </column>
            <column name="username" type="text" >
                <constraints nullable="false"/>
            </column>
            <column name="password" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="varchar(254)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="role_id" type="bigint">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>
            alter table users add constraint check_not_empty_username check(username != '');
            alter table users add constraint check_not_empty_email check(email != '');
            alter table users add constraint check_not_empty_password check(password != '');
        </sql>

        <addForeignKeyConstraint baseTableName="users" baseColumnNames="role_id"
                                 constraintName="FK_users_roles" referencedTableName="roles"
                                 referencedColumnNames="id" onDelete="RESTRICT"/>

        <rollback>
            <dropTable tableName="users"/>
        </rollback>
    </changeSet>



</databaseChangeLog>