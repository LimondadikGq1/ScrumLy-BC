<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

  <changeSet id="2025-11-21-create-notification-table" author="LimonadikGq1">
      <createTable tableName="notifications">
          <column name="id" type="bigint">
              <constraints primaryKey="true" unique="true"/>
          </column>
          <column name="sender_id" type="bigint">
              <constraints nullable="false"/>
          </column>
          <column name="recipient_id" type="bigint">
              <constraints nullable="false"/>
          </column>
          <column name="project_id" type="bigint">
              <constraints nullable="false"/>
          </column>
          <column name="message" type="text">
            <constraints nullable="true" unique="false"/>
          </column>
          <column name="is_read" type="boolean" defaultValue="false">
              <constraints nullable="false"/>
          </column>
          <column name="created_at" type="timestamptz">
              <constraints nullable="false"/>
          </column>
      </createTable>
      <addUniqueConstraint tableName="notifications" columnNames="sender_id,recipient_id,project_id"/>
      <addForeignKeyConstraint baseTableName="notifications" baseColumnNames="sender_id"
                               constraintName="FK_notifications-sender_user" referencedTableName="users"
                               referencedColumnNames="id"/>
      <addForeignKeyConstraint baseTableName="notifications" baseColumnNames="recipient_id"
                               constraintName="FK_notifications-recipient_user" referencedTableName="users"
                               referencedColumnNames="id"/>
      <addForeignKeyConstraint baseTableName="notifications" baseColumnNames="project_id"
                               constraintName="FK_notifications-projects" referencedTableName="projects"
                               referencedColumnNames="id"/>
      <sql> alter table notifications add constraint send_yourselft_yourself check(sender_id != recipient_id)</sql>
  </changeSet>
</databaseChangeLog>